if INPUT

config INPUT_AS5600_SCROLL
    bool "AS5600 magnetic dial scroll input"
    default y
    depends on I2C
    depends on DT_HAS_AYAAN_AS5600_SCROLL_ENABLED
    help
      Poll an AS5600 absolute magnetic encoder and emit accelerated vertical
      wheel events through Zephyr's input subsystem.


config INPUT_AS5600_SCROLL_DIAGNOSTICS
    bool "Verbose AS5600 dial diagnostics"
    default n
    depends on INPUT_AS5600_SCROLL
    help
      Log a roughly 1 Hz raw-angle heartbeat plus one line per emitted wheel
      event. Intended only for temporary USB-logging bring-up images; leave
      this off in release firmware, where the poll rate would flood the log.
endif
