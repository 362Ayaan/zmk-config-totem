#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>

/ {
    chosen {
        zephyr,display = &merry_display;
        zmk,display-led = &merry_backlight;
    };

    aliases {
        merry-flash = &p25q16h;
        /* The XIAO board already supplies this CDC ACM interface. Reuse it
         * for pet uploads so the composite USB device contains one CDC
         * function alongside ZMK HID, rather than two competing ports.
         */
        merry-uart = &board_cdc_acm_uart;
    };

    merry_pwm_leds: pwmleds {
        compatible = "pwm-leds";

        merry_backlight: merry_backlight {
            pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
        };
    };

    /* Zephyr 3.7+ routes ST7789V through a MIPI-DBI wrapper. The D/C polarity
     * is intentionally ACTIVE_HIGH here: the wrapper drives it low for a
     * command and high for pixel/parameter data.
     */
    merry_mipi_dbi: mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        dc-gpios = <&xiao_d 0 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&xiao_d 1 GPIO_ACTIVE_LOW>;
        spi-dev = <&xiao_spi>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        merry_display: st7789v@0 {
            compatible = "sitronix,st7789v";
            reg = <0>;
            /* The reference ZJY-IPS130-V2.0 driver uses 4 MHz. This remains
             * fast enough for the 160x174 sprite while leaving signal margin
             * for hand-soldered wiring.
             */
            mipi-max-frequency = <4000000>;
            /* This pinned Zephyr binding defines mipi-mode as an enum string,
             * not an integer macro as in older migration examples.
             */
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            /* ZJY-IPS130-V2.0 samples correctly only in SPI mode 3. These
             * properties add CPOL=1 and CPHA=1 to every command and pixel
             * transfer generated by the MIPI-DBI wrapper.
             */
            mipi-cpol;
            mipi-cpha;
            width = <240>;
            height = <240>;
            x-offset = <0>;
            y-offset = <0>;
            vcom = <0x19>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;
            mdac = <0x00>;
            gamma = <0x01>;
            colmod = <0x05>;
            lcm = <0x2c>;
            porch-param = [0c 0c 00 33 33];
            cmd2en-param = [5a 69 02 01];
            pwctrl1-param = [a4 a1];
            pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
            nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
            ram-param = [00 f0];
            rgb-param = [cd 08 14];
        };
    };
};

&xiao_spi {
    status = "okay";
};

&pinctrl {
    merry_pwm1_default: merry_pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
            nordic,invert;
        };
    };

    merry_pwm1_sleep: merry_pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
            low-power-enable;
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&merry_pwm1_default>;
    pinctrl-1 = <&merry_pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};
